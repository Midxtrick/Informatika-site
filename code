    <!-- СТРАНИЦА 3: ПРАКТИЧЕСКИЕ ЗАДАНИЯ -->
    <section id="page-tasks" class="page">
      <span class="badge">Страница 3 • Практические задания</span>
      <h1 style="font-size: 1.9rem; margin-bottom: 8px;">Задание и практика HTML</h1>
      <p style="color: var(--muted); margin-bottom: 20px;">
        Выполните задание в редакторе, нажмите «Проверить решение», а затем воспользуйтесь кнопкой «Следующий шаг».
      </p>

      <div class="task-layout">
        <aside class="task-list" id="task-list"></aside>

        <div class="workspace">
          <div class="badge" id="task-topic-badge">Тема</div>
          <h2 id="task-title" style="margin-bottom: 8px;">Задание</h2>
          <p id="task-desc" style="color: var(--muted); margin-bottom: 12px;"></p>

          <div class="preview-label">Быстрая вставка тегов</div>
          <div class="snippet-bar">
            <button type="button" class="snippet-btn" onclick="insertSnippet('<h1></h1>')">&lt;h1&gt;</button>
            <button type="button" class="snippet-btn" onclick="insertSnippet('<p></p>')">&lt;p&gt;</button>
            <button type="button" class="snippet-btn" onclick="insertSnippet('<strong></strong>')">&lt;strong&gt;</button>
            <button type="button" class="snippet-btn" onclick="insertSnippet('<a href=\"#\"></a>')">&lt;a&gt;</button>
            <button type="button" class="snippet-btn" onclick="insertSnippet('<input placeholder=\"\">')">&lt;input&gt;</button>
            <button type="button" class="snippet-btn" onclick="insertSnippet('<ul>\n  <li></li>\n</ul>')">&lt;ul&gt;</button>
            <button type="button" class="snippet-btn" onclick="insertSnippet('<button></button>')">&lt;button&gt;</button>
          </div>

          <textarea id="code-editor" class="code-editor" spellcheck="false" oninput="updatePreview()"></textarea>

          <div class="btn-group">
            <button class="btn" onclick="checkTask()">Проверить решение</button>
            <button class="btn btn-secondary" onclick="showHint()">Подсказка</button>
            <button class="btn btn-secondary" onclick="resetTask()">Сбросить код</button>
            <button id="next-step-btn" class="btn" onclick="nextStepAction()">Следующий шаг →</button>
          </div>

          <div id="feedback" class="feedback"></div>

          <div class="live-preview-wrap">
            <div class="preview-label">Живой предпросмотр</div>
            <iframe id="live-frame" class="live-frame" sandbox="allow-same-origin"></iframe>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer>
    HTML Фиолетовый практикум • 1. Введение → Теория и разделы → Практические задания
  </footer>

  <script>
    const STORAGE_KEY = "violet_html_lab_progress_v1";

    const tasks = [
      {
        id: 1,
        topic: "Введение и теги",
        title: "Задание 1. Главный заголовок и абзац",
        desc: "Создайте заголовок <h1> со словом «HTML» и абзац <p> с любым текстом внутри.",
        starter: "<!-- Напишите HTML-код здесь -->\n",
        hint: "Добавьте <h1>Основы HTML</h1> и <p>Язык разметки веб-страниц.</p>.",
        validate(code) {
          const doc = new DOMParser().parseFromString(code, "text/html");
          const h1 = doc.querySelector("h1");
          const p = doc.querySelector("p");
          if (!h1 || !h1.textContent.toLowerCase().includes("html")) {
            return "Нужен тег <h1>, содержащий слово «HTML».";
          }
          if (!p || !p.textContent.trim()) {
            return "Добавьте непустой абзац <p>.";
          }
          return null;
        }
      },
      {
        id: 2,
        topic: "Теги выделения",
        title: "Задание 2. Важное слово в <strong>",
        desc: "Внутри абзаца <p> выделите слово «код» с помощью тега <strong>.",
        starter: "<p>Писать чистый </p>",
        hint: "Добавьте <strong>код</strong> внутри <p>.",
        validate(code) {
          const doc = new DOMParser().parseFromString(code, "text/html");
          const strong = doc.querySelector("p strong");
          if (!strong || !strong.textContent.toLowerCase().includes("код")) {
            return "Поместите <strong> со словом «код» внутри тега <p>.";
          }
          return null;
        }
      },
      {
        id: 3,
        topic: "Атрибуты",
        title: "Задание 3. Ссылка с атрибутом href",
        desc: "Создайте гиперссылку <a> с непустым атрибутом href и текстом «Узнать больше».",
        starter: "<div>\n  \n</div>",
        hint: 'Используйте <a href="#topic-attrs">Узнать больше</a>.',
        validate(code) {
          const doc = new DOMParser().parseFromString(code, "text/html");
          const a = doc.querySelector("a");
          if (!a) return "Добавьте тег <a>.";
          if (!(a.getAttribute("href") || "").trim()) {
            return "Укажите непустой атрибут href у тега <a>.";
          }
          if (!a.textContent.toLowerCase().includes("узнать больше")) {
            return "В тексте ссылки должно быть «Узнать больше».";
          }
          return null;
        }
      },
      {
        id: 4,
        topic: "Атрибуты",
        title: "Задание 4. Поле ввода с placeholder",
        desc: "Добавьте тег <input> с заполненным атрибутом placeholder.",
        starter: "<form>\n  \n</form>",
        hint: 'Пример: <input type="text" placeholder="Введите e-mail">.',
        validate(code) {
          const doc = new DOMParser().parseFromString(code, "text/html");
          const input = doc.querySelector("input");
          if (!input || !(input.getAttribute("placeholder") || "").trim()) {
            return "Нужен тег <input> с непустым атрибутом placeholder.";
          }
          return null;
        }
      },
      {
        id: 5,
        topic: "Списки и структура",
        title: "Задание 5. Список из двух пунктов",
        desc: "Создайте маркированный список <ul> ровно с двумя элементами <li>.",
        starter: "<ul>\n  \n</ul>",
        hint: "Внутри <ul> напишите два тега <li> с текстом.",
        validate(code) {
          const doc = new DOMParser().parseFromString(code, "text/html");
          const items = doc.querySelectorAll("ul > li");
          if (items.length !== 2) {
            return `Сейчас элементов <li> в <ul>: ${items.length}. Нужно ровно 2.`;
          }
          if ([...items].some((li) => !li.textContent.trim())) {
            return "Каждый пункт <li> должен содержать текст.";
          }
          return null;
        }
      },
      {
        id: 6,
        topic: "Кнопки и интерактив",
        title: "Задание 6. Кнопка «Следующий шаг»",
        desc: "Создайте элемент <button> с текстом «Следующий шаг».",
        starter: "<div>\n  \n</div>",
        hint: "Напишите <button>Следующий шаг</button>.",
        validate(code) {
          const doc = new DOMParser().parseFromString(code, "text/html");
          const btn = doc.querySelector("button");
          if (!btn || !btn.textContent.toLowerCase().includes("следующий шаг")) {
            return "Добавьте <button> с текстом «Следующий шаг».";
          }
          return null;
        }
      }
    ];

    let state = loadState();
    let currentTaskIndex = 0;

    function loadState() {
      try {
        const parsed = JSON.parse(localStorage.getItem(STORAGE_KEY) || "{}");
        return {
          solved: Array.isArray(parsed.solved) ? parsed.solved : [],
          topics: Array.isArray(parsed.topics) ? parsed.topics : []
        };
      } catch {
        return { solved: [], topics: [] };
      }
    }

    function saveState() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      } catch {
        // Игнорируем ошибку хранилища
      }
    }

    function updateProgress() {
      const solvedCount = state.solved.length;
      const totalTasks = tasks.length;
      const topicsCount = state.topics.length;
      const totalItems = totalTasks + 4;
      const doneItems = solvedCount + topicsCount;
      const pct = Math.round((doneItems / totalItems) * 100);

      document.getElementById("nav-progress").textContent = `Прогресс: ${pct}%`;
      document.getElementById("progress-label").textContent =
        `Прогресс обучения: ${solvedCount} из ${totalTasks} заданий (${pct}% общий)`;
      document.getElementById("read-topics-count").textContent = topicsCount;
      document.getElementById("progress-fill").style.width = `${pct}%`;

      document.querySelectorAll(".lesson").forEach((el) => {
        const topic = el.dataset.topic;
        const btn = el.querySelector("button");
        if (btn && state.topics.includes(topic)) {
          btn.textContent = "Изучено ✓";
        }
      });
    }

    function resetAllProgress() {
      state = { solved: [], topics: [] };
      saveState();
      updateProgress();
      renderTaskList();
      document.querySelectorAll(".lesson button").forEach((btn) => {
        if (btn.textContent.includes("Изучено")) {
          btn.textContent = "Отметить изученным";
        }
      });
      showFeedback("hint", "Весь прогресс сброшен.");
    }

    function openPage(pageName) {
      document.querySelectorAll(".page").forEach((p) => p.classList.remove("active"));
      document.getElementById(`page-${pageName}`).classList.add("active");

      document.querySelectorAll(".nav-btn").forEach((btn) => {
        btn.classList.toggle("active", btn.dataset.page === pageName);
      });

      if (pageName === "tasks") {
        renderTaskList();
        updatePreview();
      }
      window.scrollTo({ top: 0, behavior: "smooth" });
    }

    function jumpToTopic(topicId) {
      openPage("theory");
      setTimeout(() => {
        document.querySelectorAll(".lesson").forEach((l) => l.classList.remove("focused"));
        const target = document.getElementById(topicId);
        if (target) {
          target.classList.add("focused");
          target.scrollIntoView({ behavior: "smooth", block: "center" });
        }
      }, 90);
    }

    function filterTopics(topicKey, btnEl) {
      document.querySelectorAll(".filter-btn").forEach((b) => b.classList.remove("active"));
      if (btnEl) btnEl.classList.add("active");

      document.querySelectorAll(".lesson").forEach((lesson) => {
        const match = topicKey === "all" || lesson.dataset.topic === topicKey;
        lesson.style.display = match ? "block" : "none";
      });
    }

    function markTopicRead(topicKey, btn) {
      if (!state.topics.includes(topicKey)) {
        state.topics.push(topicKey);
        saveState();
        updateProgress();
      }
      btn.textContent = "Изучено ✓";
    }

    function copyCode(btn, preId) {
      const text = document.getElementById(preId).innerText;
      navigator.clipboard?.writeText(text).catch(() => {});
      const prev = btn.textContent;
      btn.textContent = "Скопировано ✓";
      setTimeout(() => {
        btn.textContent = prev;
      }, 1300);
    }

    function renderTaskList() {
      const listEl = document.getElementById("task-list");
      listEl.innerHTML = "";
      tasks.forEach((task, idx) => {
        const btn = document.createElement("button");
        btn.className = "task-item-btn" + (idx === currentTaskIndex ? " active" : "");
        const done = state.solved.includes(task.id);
        btn.innerHTML = `
          <span>${task.title}</span>
          <span class="status-dot ${done ? "done" : ""}">${done ? "✓ Готово" : "Открыть"}</span>
        `;
        btn.onclick = () => selectTask(idx);
        listEl.appendChild(btn);
      });
    }

    function selectTask(idx) {
      currentTaskIndex = idx;
      const task = tasks[idx];
      document.getElementById("task-topic-badge").textContent = task.topic;
      document.getElementById("task-title").textContent = task.title;
      document.getElementById("task-desc").textContent = task.desc;
      document.getElementById("code-editor").value = task.starter;
      hideFeedback();
      renderTaskList();
      updatePreview();
    }

    function insertSnippet(snippet) {
      const editor = document.getElementById("code-editor");
      const start = editor.selectionStart ?? editor.value.length;
      const end = editor.selectionEnd ?? editor.value.length;
      editor.value = editor.value.slice(0, start) + snippet + editor.value.slice(end);
      editor.focus();
      const pos = start + snippet.length;
      editor.setSelectionRange(pos, pos);
      updatePreview();
    }

    function updatePreview() {
      const code = document.getElementById("code-editor").value;
      const frame = document.getElementById("live-frame");
      frame.srcdoc = `
        <!DOCTYPE html>
        <html lang="ru">
        <head>
          <meta charset="UTF-8">
          <style>
            body { font-family: sans-serif; padding: 12px; color: #1e1b4b; margin: 0; }
            a { color: #7e22ce; }
          </style>
        </head>
        <body>${code}</body>
        </html>
      `;
    }

    function showFeedback(type, msg) {
      const box = document.getElementById("feedback");
      box.className = `feedback show ${type}`;
      box.textContent = msg;
    }

    function hideFeedback() {
      const box = document.getElementById("feedback");
      box.className = "feedback";
      box.textContent = "";
    }

    function checkTask() {
      const task = tasks[currentTaskIndex];
      const code = document.getElementById("code-editor").value;
      const err = task.validate(code);
      if (err) {
        showFeedback("err", "Проверьте код: " + err);
      } else {
        if (!state.solved.includes(task.id)) {
          state.solved.push(task.id);
          saveState();
          updateProgress();
          renderTaskList();
        }
        showFeedback("ok", "Верно! Задание засчитано. Нажмите «Следующий шаг →», чтобы продолжить.");
      }
    }

    function nextStepAction() {
      if (currentTaskIndex < tasks.length - 1) {
        selectTask(currentTaskIndex + 1);
      } else {
        openPage("intro");
      }
    }

    function showHint() {
      showFeedback("hint", "Подсказка: " + tasks[currentTaskIndex].hint);
    }

    function resetTask() {
      document.getElementById("code-editor").value = tasks[currentTaskIndex].starter;
      hideFeedback();
      updatePreview();
    }

    updateProgress();
    selectTask(0);
  </script>
</body>
